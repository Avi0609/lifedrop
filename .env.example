# ============================================
# LifeDrop Backend Environment Configuration
# ============================================

PORT=5000

# Choose database engine: "sqlite" or "mysql"
# Default is "sqlite" (runs immediately with zero external setup)
DB_TYPE=sqlite
SQLITE_PATH=./blood_donation.db

# If switching to MySQL, set DB_TYPE=mysql and configure below:
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=blood_donation
DB_PORT=3306

